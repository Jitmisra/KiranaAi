# Razorpay TEST mode credentials. Copy this file to .env and fill it in.
# .env is gitignored and is never printed, logged, or committed.
#
# WHERE TO GET THESE (test mode needs NO KYC and no registered business):
#   1. https://dashboard.razorpay.com/signup   -- email + password is enough
#   2. Top-left mode switch: flip it to TEST MODE (it starts in test mode)
#   3. Account & Settings -> API Keys -> Generate Test Key
#   4. The key id looks like rzp_test_XXXXXXXXXXXX
#      The SECRET is shown EXACTLY ONCE. Copy it now or regenerate.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# Set this yourself to any long random string, then paste the SAME string into
# the dashboard at Account & Settings -> Webhooks -> Secret.
# Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
RAZORPAY_WEBHOOK_SECRET=

# sim = the local simulator (default, no credentials needed)
# live = the real Razorpay test-mode API
RZP_MODE=sim
